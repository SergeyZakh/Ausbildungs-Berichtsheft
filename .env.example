# Umgebungsvariablen für docker-compose.server.yml (Berichtsheft mit Konten).
# Als .env neben die Compose-Datei kopieren und ausfüllen (.env ist in .gitignore). Echte Werte gehören in den Passwort-Tresor, nie ins Repository.
# Ohne Konten (docker-compose.lokal.yml) braucht es nur KI_MODELL, und auch das
# nur, wenn ein anderes Modell als die Vorgabe geladen werden soll.

# ---------- Adresse ----------
# Genau die Adresse, unter der das Berichtsheft aufgerufen wird, ohne Schrägstrich am Ende.
# Mit https:// bekommt das Sitzungs-Cookie das Merkmal Secure.
APP_URL=https://berichtsheft.firma.intern

# Port auf dem Rechner, an den der Reverse Proxy (TLS) weiterleitet. Die Vorgabe ist nur lokal
# erreichbar; 0.0.0.0:8080 öffnet ihn fürs Netz (dann ohne https).
BERICHTSHEFT_PORT=127.0.0.1:8080

TZ=Europe/Berlin

# ---------- Datenbank ----------
# Mindestens 24 Zeichen, nur Buchstaben und Ziffern (steht in einer Verbindungs-URL). Erzeugen:
#   openssl rand -hex 24
DB_PASSWORD=PLATZHALTER_DB_PASSWORT

# ---------- Sitzung ----------
# Signiert das Sitzungs-Cookie. Mindestens 32 Zeichen, erzeugen mit: openssl rand -hex 32
# Ein neuer Wert meldet alle ab, Daten gehen dabei nicht verloren.
SITZUNG_GEHEIMNIS=PLATZHALTER_SITZUNG_GEHEIMNIS
# Wie lange eine Anmeldung hält, in Stunden.
SITZUNG_STUNDEN=10
# 1: ohne Anmeldung kein Zugang, die Seite leitet gleich zum Anmeldedienst weiter.
# 0: Anmelden ist freiwillig; ohne Konto bleibt alles im Browser, und kein Ausbilder sieht es.
ANMELDUNG_PFLICHT=1

# ---------- Anmeldung (OIDC) ----------
# Rückkehradresse, die beim Anbieter eingetragen wird: <APP_URL>/anmeldung/rueckkehr
# Nach dem Abmelden zurück auf:                        <APP_URL>/
# Rollen kommen aus den Gruppen im ID-Token: <Präfix>azubi und <Präfix>ausbilder.
# Wer in keiner der beiden Gruppen ist, kommt nicht hinein.
# Ein Block je Anbieter; genau einen einkommentieren.

# --- Keycloak (Realm aus keycloak/realm-berichtsheft.json) ---
OIDC_ISSUER=https://anmeldung.firma.intern/realms/berichtsheft
OIDC_CLIENT_ID=berichtsheft
OIDC_CLIENT_SECRET=PLATZHALTER_CLIENT_SECRET

# --- Authentik (Provider „OAuth2/OpenID“, Anwendungs-Slug „berichtsheft“) ---
# OIDC_ISSUER=https://authentik.firma.intern/application/o/berichtsheft/
# OIDC_CLIENT_ID=PLATZHALTER_CLIENT_ID
# OIDC_CLIENT_SECRET=PLATZHALTER_CLIENT_SECRET

# --- Entra ID (Microsoft 365) ---
# Gruppen als Namen statt IDs: in der App-Registrierung „Token configuration → Add groups claim“
# mit „sAMAccountName“ (nur synchronisierte Gruppen) oder App-Rollen mit OIDC_GRUPPEN_CLAIM=roles.
# OIDC_ISSUER=https://login.microsoftonline.com/<Tenant-ID>/v2.0
# OIDC_CLIENT_ID=<Anwendungs-ID>
# OIDC_CLIENT_SECRET=PLATZHALTER_CLIENT_SECRET
# OIDC_GRUPPEN_CLAIM=roles

# Nur ändern, wenn der Anbieter andere Namen verwendet.
# OIDC_GRUPPEN_CLAIM=groups
# OIDC_GRUPPEN_PRAEFIX=berichtsheft-
# OIDC_NAME_CLAIM=name
# OIDC_SCOPES=openid profile email

# ---------- Sicherung ----------
# Uhrzeit der nächtlichen Sicherung (HH:MM, Zeitzone aus TZ) und Aufbewahrung in Tagen.
SICHERUNG_UHRZEIT=02:30
SICHERUNG_TAGE=14

# ---------- Sprachmodell (alle Compose-Dateien) ----------
# Modell, das der Dienst ollama-modelle beim Start lädt. Im Werkzeug unter „Deine Daten →
# Sprachmodell“ denselben Namen und als Adresse „/ki“ eintragen.
KI_MODELL=qwen3.5:4b
